# Environment : development / preproduction / production
ENVIRONMENT=development

# URL de connexion utilisée par Prisma
DATABASE_URL="postgresql://dahlia:dahlia@localhost:5432/dahlia?schema=public"

# TELERECOURS (Pour le tribunal administratif du Rhône, les variables d'environnement
# commencent par TA069_)
TA069_TELERECOURS_USERNAME=
TA069_TELERECOURS_PASSWORD=
# IDs des divisions (legalEntityDivisionIds), séparés par des virgules (ex. 1234,5678)
# Dans le cas du département du Rhône (69), correspond au service DDTES
TA069_TELERECOURS_DIVISIONS=

# better-auth
# Clé secrète pour signer les sessions/cookies. Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL de base de l'application (sans slash final).
BETTER_AUTH_URL=http://localhost:3000

# ProConnect (OIDC) — identifiants de l'app DAHLIA déclarée sur l'espace partenaire.
PROCONNECT_CLIENT_ID=
PROCONNECT_CLIENT_SECRET=
# Domaine de base ProConnect (les endpoints OIDC vivent sous /api/v2).
# Intégration : https://fca.integ01.dev-agentconnect.fr
PROCONNECT_URL=https://fca.integ01.dev-agentconnect.fr
