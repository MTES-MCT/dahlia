# Environment : development / preproduction / production
ENVIRONMENT=development

# Désactive l'affichage des fichiers factices lors de l'accès aux PDFs
NO_FAKE_FILE=false

# Désactive l'anonymisation des acteurs et textes lors du scrape / rafraîchissement Télérecours (hors production uniquement utile).
NO_ANONYMIZE=false

# URL de connexion utilisée par Prisma
DATABASE_URL="postgresql://dahlia:dahlia@localhost:5432/dahlia?schema=public"

# TELERECOURS (Pour le tribunal administratif du Rhône, les variables d'environnement
# commencent par TA069_)
TA069_TELERECOURS_USERNAME=
TA069_TELERECOURS_PASSWORD=
# IDs des divisions (legalEntityDivisionIds), séparés par des virgules (ex. 1234,5678)
# Dans le cas du département du Rhône (69), correspond au service DDTES
# Optionnel : sans cette variable, aucun filtre de division n'est appliqué.
TA069_TELERECOURS_DIVISIONS=
# Second compte du même tribunal : juridiction Dahlia distincte (TA069bis),
# identifiants propres, en-tête API commun (TA069).
# TA069bis_TELERECOURS_USERNAME=…
# TA069bis_TELERECOURS_PASSWORD=…
# TA069bis_TELERECOURS_JURISDICTION=TA069

# DocumentIA — interprétation des pièces (décisions COMED) :
# `pnpm interpret:comed` et `pnpm scrape:telerecours -- --document-ia`.
# URL de base de l'API (sans /api, sans slash final). En local : http://localhost:8000
DOCUMENT_IA_URL=http://localhost:8000
# Clé API (en-tête X-API-KEY), format dia_<env>_v<version>_…
DOCUMENT_IA_API_KEY=
# Optionnel : workflow v2 utilisé (défaut document-classification-extraction-v2).
# DOCUMENT_IA_WORKFLOW_ID=document-classification-extraction-v2
# Optionnel : intervalle de polling et délai max d'attente d'une exécution (ms).
# DOCUMENT_IA_POLL_INTERVAL_MS=2000
# DOCUMENT_IA_TIMEOUT_MS=300000

# better-auth
# Clé secrète pour signer les sessions/cookies. Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL de base de l'application (sans slash final).
BETTER_AUTH_URL=http://localhost:3000

# Lien « Documentation » dans l'en-tête (utilisateurs connectés), ou vide pour masquer.
DAHLIA_DOCUMENTATION_URL=https://dahlia-documentation.osc-secnum-fr1.scalingo.io

# ProConnect (OIDC) — identifiants de l'app DAHLIA déclarée sur l'espace partenaire.
PROCONNECT_CLIENT_ID=
PROCONNECT_CLIENT_SECRET=
# Domaine de base ProConnect (les endpoints OIDC vivent sous /api/v2).
# Intégration : https://fca.integ01.dev-agentconnect.fr
PROCONNECT_URL=https://fca.integ01.dev-agentconnect.fr

# Stockage S3 (Outscale) — PDF factices servis hors production
# (`<S3_PREFIX>/mocked_pdfs/<fichier>.pdf`). Optionnel : sans S3_BUCKET et
# clés d'accès, les PDF sont lus dans le dossier local `files/mocked_pdfs`.
S3_ENDPOINT=https://oos.cloudgouv-eu-west-1.outscale.com
S3_REGION=cloudgouv-eu-west-1
S3_BUCKET=dahlia
S3_PREFIX=files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nécessaires avec les versions récentes du SDK AWS v3 sur un stockage non-AWS
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED
