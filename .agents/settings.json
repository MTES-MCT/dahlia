{
  "permissions": {
    "allow": [
      "Bash(curl -s:*)",
      "Bash(curl -L:*)",
      "Bash(curl -I:*)",
      "Bash(curl -X GET:*)",
      "Bash(curl --get:*)",
      "Bash(curl:*)",
      "Bash(grep:*)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:unit *)",
      "Bash(pnpm test:integration *)",
      "Bash(pnpm format *)",
      "Bash(pnpm format:check *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec prettier*)",
      "Bash(pnpm build *)",
      "Bash(pnpm dev *)",
      "Bash(pnpm db:generate *)",
      "Bash(pnpm db:format *)",
      "Bash(pnpm exec vitest *)",
      "Bash(rg:*)",
      "Read(./.env.example)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./tmp/**)", "Read(./webapp_dbdata/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": ".agents/hooks/guard-bash.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": ".agents/hooks/post-edit.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": ".agents/hooks/stop-check.sh" }]
      }
    ]
  }
}
