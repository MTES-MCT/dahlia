{
  "permissions": {
    "allow": [
      "Bash(curl -s:*)",
      "Bash(curl -L:*)",
      "Bash(curl -I:*)",
      "Bash(curl -X GET:*)",
      "Bash(curl --get:*)",
      "Bash(curl:*)",
      "Bash(grep:*)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:unit *)",
      "Bash(pnpm test:integration *)",
      "Bash(pnpm format *)",
      "Bash(pnpm format:check *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec prettier*)",
      "Bash(pnpm build *)",
      "Bash(pnpm dev *)",
      "Bash(pnpm db:migrate *)",
      "Bash(pnpm db:generate *)",
      "Bash(pnpm db:format *)",
      "Bash(rg:*)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "npx tsc --noEmit || true" }]
      }
    ]
  }
}
