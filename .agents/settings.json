{
  "permissions": {
    "allow": [
      "Bash(curl -s:*)",
      "Bash(curl -L:*)",
      "Bash(curl -I:*)",
      "Bash(curl -X GET:*)",
      "Bash(curl --get:*)",
      "Bash(curl:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "npx tsc --noEmit || true" }]
      }
    ]
  }
}
