{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "react-dsfr update-icons",
    "prebuild": "react-dsfr update-icons",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "scrape:telerecours": "ts-node -P data/tsconfig.json data/cli/scrape-telerecours.ts",
    "download:dev": "ts-node -P data/tsconfig.json data/telecharge-fichier.ts",
    "reschedule-deliberation:dev": "ts-node -P data/tsconfig.json data/cli/reschedule-deliberation-case-files.ts",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test": "pnpm test:unit && pnpm test:integration",
    "prepare": "husky"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.33.0",
    "@faker-js/faker": "^10.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^7.10.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.23",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.3",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": ">=8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": ">=8.1.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.0.0"
  }
}
