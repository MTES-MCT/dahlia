{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "react-dsfr update-icons",
    "prebuild": "react-dsfr update-icons",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "scrape:dev": "ts-node -P data/tsconfig.json data/cli/scrape-telerecours.ts",
    "download:dev": "ts-node -P data/tsconfig.json data/telecharge-fichier.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.32.4",
    "@faker-js/faker": "^10.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/config": "^7.8.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.20",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "postcss": ">=8.5.10",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": ">=8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
