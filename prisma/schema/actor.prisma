enum ActorType {
  LEGAL_PERSON
  NATURAL_PERSON
}

model Actor {
  id              Int       @id
  firstName       String?
  lastName        String?
  lastFirstName   String?
  firstLastName   String?
  legalPersonName String?
  legalEntityName String?
  legalEntityId   Int?
  actorType       ActorType

  // Column computed by Postgres (GENERATED ALWAYS ... STORED, cf. migration)
  // reproducing getActorDisplayName, to allow sorting in the database on the
  // displayed name. Read-only: never write it (the scraper must not pass it).
  displayName String?

  // Computed column: lower(f_unaccent(displayName)) — used for accent-insensitive
  // text search (cf. migration search_unaccent).
  // Read-only. On the app side, normalize the query the same way before
  // using `contains` on it.
  displayNameNormalized String?

  qualityCode String
  quality     Quality @relation(fields: [qualityCode], references: [code])

  caseFilesAsMainClaimant CaseFile[] @relation("CaseFileMainClaimant")
  caseFilesAsMainDefender CaseFile[] @relation("CaseFileMainDefender")

  @@map("actors")
}

model Quality {
  code String @id
  name String @unique

  actors Actor[]

  @@map("qualities")
}
