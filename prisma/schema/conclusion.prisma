// Conclusion attached to a hearing. Telerecours conclusion ids are not global:
// the same numeric id can exist on different hearings, so the PK is composite.
model Conclusion {
  jurisdictionCode String
  id               Int
  hearingId        String
  hearing          Hearing @relation("HearingConclusions", fields: [jurisdictionCode, hearingId], references: [jurisdictionCode, hearingId], onDelete: Cascade)

  conclusionSense String?
  publicationDate DateTime
  author          String?

  conclusionOperativePartId Int?
  conclusionOperativePart   ConclusionOperativePart? @relation(fields: [conclusionOperativePartId], references: [id])

  // Back-relation for Hearing.lastConclusion (at most one hearing points here as last).
  hearingAsLast Hearing? @relation("HearingLastConclusion")

  @@id([jurisdictionCode, hearingId, id])
  @@map("conclusions")
}

model ConclusionOperativePart {
  id    Int    @id
  label String @unique

  conclusions Conclusion[]

  @@map("conclusion_operative_parts")
}
