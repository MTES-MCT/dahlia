// Type de contentieux du dossier, saisi manuellement par l'utilisateur.
enum LitigationType {
  LIQUIDATION_ASTREINTE // Liquidation d'astreinte
  INJONCTION // Recours injonction
  INDEMNITAIRE // Recours indemnitaire
  EXCES_DE_POUVOIR // Recours en excès de pouvoir (REP)
  REFERE // Référé
}

// Type de droit concerné (DALO / DAHO), saisi manuellement par l'utilisateur.
enum RightType {
  DALO // Logement
  DAHO // Hébergement
}

// Type d'échéance à produire, saisi manuellement pour les dossiers en cours d'instruction.
enum ProductionDeadlineType {
  MISE_EN_DEMEURE_DE_PRODUIRE // Mise en demeure de produire
  CLOTURE_INSTRUCTION // Clôture d'instruction
}

model CaseFile {
  caseFileNumber String @id

  // Champs renseignés par l'endpoint /api/case-file (liste) et enrichis
  // par /api/case-file/<id> (detail) pour les dossiers au statut cible.
  title                          String?
  creationDate                   DateTime?
  depositDate                    DateTime?
  type                           String?
  estimatedHearingDate           DateTime?
  estimatedHearingPeriod         String?
  earliestInstructionClosingDate DateTime?
  directoryReference             String?
  directoryComplementaryEmails   String?
  keywords                       String[]  @default([])
  recipientContactCount          Int?

  assignedToLegalEntityDivisionId Int
  assignedToLegalEntityDivision   LegalEntityDivision @relation(fields: [assignedToLegalEntityDivisionId], references: [id])

  urgencyId Int?
  urgency   Urgency? @relation(fields: [urgencyId], references: [id])

  lastStatusId   Int
  lastStatus     Status   @relation(fields: [lastStatusId], references: [id])
  lastStatusDate DateTime

  lastHearingId String?
  lastHearing   Hearing? @relation("CaseFileLastHearing", fields: [lastHearingId], references: [hearingId])

  // Liste complète des audiences du dossier (alimentée par
  // /api/case-file/<id>/hearings — phase B du scraper).
  hearings Hearing[] @relation("CaseFileHearings")

  procedureState String?

  // User-managed classification fields (edited from the case-file details card).
  litigationType LitigationType?
  rightType      RightType?
  // Short free-text label (a few words) characterizing the case; shown as "Raison".
  summary        String?

  // Production deadline tracked for case files under instruction (null = none).
  productionDeadlineType ProductionDeadlineType?
  productionDeadlineDate DateTime?

  // Denormalized convocation date of `lastHearing`, maintained by the scraper so
  // the dashboard can sort on the effective memory deadline without a join.
  lastHearingConvocationDate DateTime?
  // Generated in Postgres: COALESCE(productionDeadlineDate, lastHearingConvocationDate).
  // Prisma 7 does not model generated columns; declared as a plain nullable field.
  memoryDeadlineDate DateTime?

  // Set to true when a case file present in DB is no longer returned by the
  // Telerecours list scrape within the same perimeter (see scrape-telerecours
  // reconciliation). Soft delete: hidden from the UI but kept in DB.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  chamberId Int?
  chamber   Chamber? @relation(fields: [chamberId], references: [id])

  // All actors participating in the case file (scraped from /api/case-file/<id>/actors).
  // Main claimant/defender are identified by isMainClaimant / isMainDefender on the link.
  caseFileActors       CaseFileActor[]
  actorRepresentations ActorRepresentation[]

  // Actor of the most recent "reception…" event (see findLastProducerId in the
  // scraper, computed during the enrichment phase).
  lastProducerId Int?
  lastProducer   Actor? @relation("CaseFileLastProducer", fields: [lastProducerId], references: [id])

  lastDecisionReading LastDecisionReading?

  events         CaseFileEvent[]
  attachedFiles  AttachedFile[]
  relatedSources RelatedCaseFile[] @relation("RelatedCaseFileSource")
  relatedTargets RelatedCaseFile[] @relation("RelatedCaseFileTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Telerecours synchronization tracking (distinct from `updatedAt`, which is
  // Prisma-managed and changes on any write). Both are maintained by the scraper
  // during the enrichment phase.
  //   - telerecoursSyncAt: last time the case file was synced with Telerecours
  //     (updated on every scrape, regardless of any change).
  //   - telerecoursUpdatedAt: last time a scrape actually changed the case file
  //     or one of its linked elements (unchanged when nothing changed).
  // `telerecoursContentHash` is the fingerprint of the last scraped payload,
  // used to detect whether anything changed between two scrapes.
  telerecoursSyncAt      DateTime?
  telerecoursUpdatedAt   DateTime?
  telerecoursContentHash String?

  @@map("case_files")
}
