model CaseFile {
  caseFileNumber String @id

  // Champs renseignés par l'endpoint /api/case-file (liste) et enrichis
  // par /api/case-file/<id> (detail) pour les dossiers au statut cible.
  title                          String?
  creationDate                   DateTime?
  depositDate                    DateTime?
  type                           String?
  estimatedHearingDate           DateTime?
  estimatedHearingPeriod         String?
  earliestInstructionClosingDate DateTime?
  lastDecisionReading            DateTime?
  directoryReference             String?
  directoryComplementaryEmails   String[]  @default([])
  keywords                       String[]  @default([])
  recipientContactCount          Int?

  assignedToLegalEntityDivisionId Int
  assignedToLegalEntityDivision   LegalEntityDivision @relation(fields: [assignedToLegalEntityDivisionId], references: [id])

  urgencyId Int?
  urgency   Urgency? @relation(fields: [urgencyId], references: [id])

  lastStatusId   Int
  lastStatus     Status   @relation(fields: [lastStatusId], references: [id])
  lastStatusDate DateTime

  lastHearingId String?
  lastHearing   Hearing? @relation("CaseFileLastHearing", fields: [lastHearingId], references: [hearingId])

  // Liste complète des audiences du dossier (alimentée par
  // /api/case-file/<id>/hearings — phase B du scraper).
  hearings Hearing[] @relation("CaseFileHearings")

  procedureState String?

  // Set to true when a case file present in DB is no longer returned by the
  // Telerecours list scrape within the same perimeter (see scrape-telerecours
  // reconciliation). Soft delete: hidden from the UI but kept in DB.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  chamberId Int?
  chamber   Chamber? @relation(fields: [chamberId], references: [id])

  mainClaimantId Int
  mainClaimant   Actor @relation("CaseFileMainClaimant", fields: [mainClaimantId], references: [id])

  mainDefenderId Int?
  mainDefender   Actor? @relation("CaseFileMainDefender", fields: [mainDefenderId], references: [id])

  // Actor of the most recent "reception…" event (see findLastProducerId in the
  // scraper, computed during the enrichment phase).
  lastProducerId Int?
  lastProducer   Actor? @relation("CaseFileLastProducer", fields: [lastProducerId], references: [id])

  events         CaseFileEvent[]
  attachedFiles  AttachedFile[]
  relatedSources RelatedCaseFile[] @relation("RelatedCaseFileSource")
  relatedTargets RelatedCaseFile[] @relation("RelatedCaseFileTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("case_files")
}
