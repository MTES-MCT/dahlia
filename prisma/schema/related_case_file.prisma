// Lien typé entre dossiers : un CaseFile peut être lié à plusieurs autres
// dossiers (rapport "related-case-files"). Les deux côtés du lien sont des
// FK strictes vers CaseFile — donc les dossiers cibles doivent avoir été
// scrapés au préalable. Sinon le scraper logge un warning et incrémente un
// compteur de liens orphelins (cf. scrape-telerecours.ts, phase C).
model RelatedCaseFile {
  // Both case files belong to the same court (the related report is scoped to it).
  jurisdictionCode String

  caseFileNumber String
  caseFile       CaseFile @relation("RelatedCaseFileSource", fields: [jurisdictionCode, caseFileNumber], references: [jurisdictionCode, caseFileNumber], onDelete: Cascade)

  relatedCaseFileNumber String
  relatedCaseFile       CaseFile @relation("RelatedCaseFileTarget", fields: [jurisdictionCode, relatedCaseFileNumber], references: [jurisdictionCode, caseFileNumber], onDelete: Cascade)

  @@id([jurisdictionCode, caseFileNumber, relatedCaseFileNumber])
  @@index([jurisdictionCode, relatedCaseFileNumber])
  @@map("related_case_files")
}
