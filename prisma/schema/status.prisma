// `statusDate` n'est pas porté ici : c'est une donnée d'application
// d'un statut à un dossier, stockée sur `CaseFile.lastStatusDate`.
// Ce modèle représente le catalogue des statuts possibles.
model Status {
  id       Int    @id
  label    String
  category String
  groupId  Int

  // Computed column: lower(f_unaccent(label)) — used for accent-insensitive
  // text search (cf. migration status_label_normalized). Read-only.
  labelNormalized String?

  caseFiles CaseFile[]

  @@map("statuses")
}
