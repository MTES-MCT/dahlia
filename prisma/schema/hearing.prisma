// Participation of a case file in a hearing session (M2M).
// Telerecours nests hearings under /api/case-file/<id>/hearings, but the same
// hearingId can appear on several case files (shared session).
model CaseFileHearing {
  // Telerecours court code, part of every composite key (see CaseFile).
  jurisdictionCode String

  caseFileNumber String
  caseFile       CaseFile @relation(fields: [jurisdictionCode, caseFileNumber], references: [jurisdictionCode, caseFileNumber], onDelete: Cascade)

  hearingId String
  hearing   Hearing @relation(fields: [jurisdictionCode, hearingId], references: [jurisdictionCode, hearingId], onDelete: Cascade)

  @@id([jurisdictionCode, caseFileNumber, hearingId])
  @@index([jurisdictionCode, hearingId])
  @@map("case_file_hearings")
}

// Hearing ids are only unique within a court: the primary key is
// (jurisdictionCode, hearingId).
model Hearing {
  jurisdictionCode  String
  hearingId         String
  convocationDate   DateTime
  room              String?
  creationDate      DateTime?
  modificationDates DateTime[]

  // "Current" conclusion for this hearing (mirrors CaseFile.lastHearing).
  // Composite FK: conclusion ids are only unique within a hearing.
  lastConclusionId Int?
  lastConclusion   Conclusion? @relation("HearingLastConclusion", fields: [jurisdictionCode, hearingId, lastConclusionId], references: [jurisdictionCode, hearingId, id], onDelete: SetNull)

  // All conclusions observed for this hearing (mirrors CaseFile ↔ hearings list).
  conclusions Conclusion[] @relation("HearingConclusions")

  caseFileHearings CaseFileHearing[]

  // Case files that have this hearing as `lastHearing`.
  caseFilesAsLast CaseFile[] @relation("CaseFileLastHearing")

  @@id([jurisdictionCode, hearingId])
  @@unique([jurisdictionCode, hearingId, lastConclusionId])
  @@map("hearings")
}
