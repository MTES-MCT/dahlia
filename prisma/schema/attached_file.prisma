// Catalogue des familles de pièces Télérecours (DIN, REQ, COUK, …).
model FileFamilyType {
  code  String @id
  label String

  attachedFiles AttachedFile[]

  @@map("file_family_types")
}

// Pièce jointe d'un dossier. `encodedFileId` est l'identifiant opaque
// fourni par Télérecours (sert à télécharger le contenu via une autre API).
// On ne stocke ici que les métadonnées, pas le contenu binaire.
// `encodedFileId` is base64("/ATTACHMENT/<n>"), a per-court counter: the
// primary key is (jurisdictionCode, encodedFileId).
model AttachedFile {
  jurisdictionCode          String
  encodedFileId             String
  originalFileName          String
  fileName                  String
  mimeType                  String
  documentType              String
  subEventId                Int      @default(0)
  receiptAcknowledgmentId   Int?
  receiptAcknowledgmentType String?
  fileTypeLabel             String
  eventCreationDate         DateTime

  // Denormalized from fileFamilyType.label at import time (GENERATED search
  // columns cannot join other tables).
  fileFamilyTypeLabel String?

  // Computed columns for accent-insensitive search (cf. migration table_search_normalized).
  dahliaNameNormalized          String?
  fileNameNormalized            String?
  fileTypeLabelNormalized       String?
  fileFamilyTypeLabelNormalized String?

  // DAHLIA editable metadata (optional, set by users on the pièce edition page).
  // `number` is a string so leading zeros are preserved (e.g. "002").
  dahliaName String?
  number     String?
  comment    String?

  caseFileNumber String
  caseFile       CaseFile @relation(fields: [jurisdictionCode, caseFileNumber], references: [jurisdictionCode, caseFileNumber], onDelete: Cascade)

  eventId Int
  event   CaseFileEvent @relation(fields: [jurisdictionCode, eventId], references: [jurisdictionCode, id])

  fileFamilyTypeCode String
  fileFamilyType     FileFamilyType @relation(fields: [fileFamilyTypeCode], references: [code])

  @@id([jurisdictionCode, encodedFileId])
  @@index([jurisdictionCode, caseFileNumber])
  @@index([jurisdictionCode, eventId])
  @@map("attached_files")
}
