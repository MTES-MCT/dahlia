// Participation of an actor in a case file. Role flags and quality are scoped
// to this link (not duplicated on CaseFile or Actor).
model CaseFileActor {
  // Telerecours court code, part of every composite key (see CaseFile).
  jurisdictionCode String

  caseFileNumber String
  caseFile       CaseFile @relation(fields: [jurisdictionCode, caseFileNumber], references: [jurisdictionCode, caseFileNumber], onDelete: Cascade)

  actorId Int
  actor   Actor @relation(fields: [jurisdictionCode, actorId], references: [jurisdictionCode, id])

  qualityCode String
  quality     Quality @relation(fields: [qualityCode], references: [code])

  isMainClaimant Boolean @default(false)
  isMainDefender Boolean @default(false)

  @@id([jurisdictionCode, caseFileNumber, actorId])
  @@index([jurisdictionCode, actorId])
  @@map("case_file_actors")
}

// Representation link within a case file (e.g. lawyer representing a claimant).
model ActorRepresentation {
  // Telerecours court code, part of every composite key (see CaseFile).
  jurisdictionCode String

  caseFileNumber String
  caseFile       CaseFile @relation(fields: [jurisdictionCode, caseFileNumber], references: [jurisdictionCode, caseFileNumber], onDelete: Cascade)

  representedActorId Int
  representedActor   Actor @relation("RepresentedActor", fields: [jurisdictionCode, representedActorId], references: [jurisdictionCode, id])

  representativeActorId Int
  representativeActor   Actor @relation("RepresentativeActor", fields: [jurisdictionCode, representativeActorId], references: [jurisdictionCode, id])

  @@id([jurisdictionCode, caseFileNumber, representedActorId, representativeActorId])
  @@map("actor_representations")
}
