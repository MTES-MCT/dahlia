// Juridiction Télérecours (tribunal administratif) ayant servi au scraping.
// `shortName` porte le code Télérecours (ex. "TA069") : c'est la clé
// fonctionnelle, celle passée en `--jurisdiction` au scraper et utilisée pour
// résoudre les identifiants `<CODE>_TELERECOURS_USERNAME/PASSWORD`.
// `name` (libellé complet) est laissé vide par le scraper et édité à la main.
// Contrairement à LegalEntityDivision, l'id n'est pas fourni par Télérecours :
// il est généré côté Postgres.
model Jurisdiction {
  id        Int    @id @default(autoincrement())
  name      String @default("")
  shortName String @unique

  caseFiles CaseFile[]

  @@map("jurisdictions")
}
