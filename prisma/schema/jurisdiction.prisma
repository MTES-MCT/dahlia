// Télérecours court (administrative tribunal) this scrape ran against.
// `shortName` is the Dahlia jurisdiction key (e.g. "TA069", "TA069bis"):
// credential prefix and stored instance. API calls send it as
// `X-Jurisdiction-Code`, unless `<shortName>_TELERECOURS_JURISDICTION`
// overrides that header only.
// `name` (full label) is left empty by the scraper and edited by hand.
// Unlike LegalEntityDivision, the id is not provided by Télérecours:
// Postgres generates it.
model Jurisdiction {
  id               Int    @id @default(autoincrement())
  name             String @default("")
  shortName        String @unique
  // Telerecours court this instance belongs to (the X-Jurisdiction-Code header,
  // e.g. "TA069" for both TA069 and TA069bis). Not unique: several instances
  // may share a court. Copied onto every court-scoped row as `jurisdictionCode`.
  jurisdictionCode String

  caseFiles  CaseFile[]
  userScopes UserJurisdictionScope[]

  @@map("jurisdictions")
}
