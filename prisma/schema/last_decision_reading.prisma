model LastDecisionReading {
  jurisdictionCode String
  caseFileNumber   String

  readingDate      DateTime
  notificationDate DateTime?
  nature           String?
  operativePart    String?

  caseFile CaseFile @relation(fields: [jurisdictionCode, caseFileNumber], references: [jurisdictionCode, caseFileNumber], onDelete: Cascade)

  @@id([jurisdictionCode, caseFileNumber])
  @@map("last_decision_readings")
}
